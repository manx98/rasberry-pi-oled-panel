#!/bin/sh
set -e

case "${1:-}" in
    remove|purge|disappear)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || :
        fi
        ;;
esac

if [ "${1:-}" = purge ]; then
    # Settings survive an upgrade and ordinary package removal, but are
    # deleted when the administrator explicitly purges the package.
    rm -rf /var/lib/raspberry-pi-oled-panel
fi
exit 0
